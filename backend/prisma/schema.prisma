generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  DONOR
  NGO
  VOLUNTEER
  ADMIN
}

enum DonationStatus {
  AVAILABLE
  REQUESTED
  ACCEPTED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  EXPIRED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DeliveryStatus {
  PENDING_VOLUNTEER
  VOLUNTEER_ASSIGNED
  PICKUP_CONFIRMED
  IN_TRANSIT
  DELIVERY_CONFIRMED
  CANCELLED
  FAILED
}

enum NotificationType {
  DONATION_CREATED
  REQUEST_RECEIVED
  REQUEST_APPROVED
  REQUEST_REJECTED
  DELIVERY_ASSIGNED
  PICKUP_CONFIRMED
  DELIVERY_STARTED
  DELIVERY_COMPLETED
  DONATION_EXPIRING_SOON
  VERIFICATION_RESULT
  RECOMMENDATION_INVITE
  SYSTEM_ALERT
}

enum RecommendationAction {
  ACCEPTED
  IGNORED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role                    UserRole
  isActive                Boolean  @default(true)
  notificationPreferences Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Role-specific 1-to-1 profiles
  donorProfile     DonorProfile?
  ngoProfile       NGOProfile?
  volunteerProfile VolunteerProfile?

  // 1-to-Many notifications
  notifications Notification[]

  @@index([email])
  @@index([role])
}

model DonorProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  organizationName   String
  businessType       String             @default("General")
  address            String
  latitude           Float?
  longitude          Float?
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  donations Donation[]
}

model NGOProfile {
  id                  String             @id @default(uuid())
  userId              String             @unique
  organizationName    String
  contactPerson       String
  registrationNumber  String?            @unique
  address             String
  serviceArea         String
  latitude            Float?
  longitude           Float?
  capacity            Int?
  preferredCategories String[]           @default([])
  requiredQuantity    Int?
  currentRequirements String?
  isVerified          Boolean            @default(false)
  verificationStatus  VerificationStatus @default(PENDING)
  verificationNotes   String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  donationRequests DonationRequest[]
}

model VolunteerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  address          String?
  serviceArea      String?
  vehicleType      String?
  isAvailable      Boolean  @default(true)
  currentLatitude  Float?
  currentLongitude Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries Delivery[]
}

model Donation {
  id                  String         @id @default(uuid())
  donorId             String
  title               String
  description         String?
  foodCategory        String
  quantity            Int
  unit                String
  preparedAt          DateTime       @default(now())
  expiresAt           DateTime
  pickupAddress       String
  latitude            Float?
  longitude           Float?
  imageUrl            String?
  packagingInfo       String?
  allergenInfo        String?
  storageRequirements String?
  safetyChecklist     Json?
  safetyWarnings      String[]       @default([])
  expiryAlertSentAt   DateTime?
  status              DonationStatus @default(AVAILABLE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  donor    DonorProfile      @relation(fields: [donorId], references: [id], onDelete: Cascade)
  requests DonationRequest[]
  delivery Delivery?
  reports  DonationReport[]

  @@index([status])
  @@index([expiresAt])
}

model DonationRequest {
  id                String        @id @default(uuid())
  donationId        String
  ngoId             String
  requestedQuantity Int?
  notes             String?
  status            RequestStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  donation Donation   @relation(fields: [donationId], references: [id], onDelete: Cascade)
  ngo      NGOProfile @relation(fields: [ngoId], references: [id], onDelete: Cascade)

  // Ensure an NGO cannot submit duplicate requests for the same donation
  @@unique([donationId, ngoId])
  @@index([status])
}

model Delivery {
  id                      String         @id @default(uuid())
  donationId              String         @unique
  ngoId                   String
  volunteerId             String?
  status                  DeliveryStatus @default(PENDING_VOLUNTEER)
  pickupAddress           String
  pickupLatitude          Float?
  pickupLongitude         Float?
  deliveryAddress         String
  deliveryLatitude        Float?
  deliveryLongitude       Float?
  pickupQrToken           String?
  pickupQrUsedAt          DateTime?
  deliveryQrToken         String?
  deliveryQrUsedAt        DateTime?
  isLocationSharing       Boolean        @default(false)
  lastVolunteerLat        Float?
  lastVolunteerLng        Float?
  lastLocationUpdatedAt   DateTime?
  estimatedArrivalMinutes Int?
  pickedUpAt              DateTime?
  deliveredAt             DateTime?
  notes                   String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  donation  Donation          @relation(fields: [donationId], references: [id], onDelete: Cascade)
  volunteer VolunteerProfile? @relation(fields: [volunteerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([ngoId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model RecommendationFeedback {
  id         String               @id @default(uuid())
  userId     String
  donationId String
  ngoId      String
  action     RecommendationAction
  createdAt  DateTime             @default(now())

  @@unique([userId, donationId, ngoId])
  @@index([userId, action])
}

model VerificationRecord {
  id                String             @id @default(uuid())
  targetType        String             // 'NGO' | 'DONOR'
  targetProfileId   String
  status            VerificationStatus
  notes             String?
  reviewedByAdminId String
  createdAt         DateTime           @default(now())

  @@index([targetType, targetProfileId])
  @@index([createdAt])
}

model DonationReport {
  id                String       @id @default(uuid())
  donationId        String
  reportedByUserId  String
  reason            String
  details           String?
  status            ReportStatus @default(OPEN)
  adminNotes        String?
  reviewedByAdminId String?
  reviewedAt        DateTime?
  createdAt         DateTime     @default(now())

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([donationId])
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
