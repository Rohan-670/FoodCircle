# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL(s) for CORS allowance (comma-separated for multiple origins in production)
CLIENT_URL=http://localhost:5173

# Routing Provider URL (OSRM driving route API)
ROUTING_API_URL=https://router.project-osrm.org/route/v1/driving

# Database (PostgreSQL with Prisma connection string)
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/surplus_food_db?schema=public

# Authentication (JWT Secret and Expiry)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Initial Admin Seed Configuration (used only by `npm run seed:admin`)
ADMIN_EMAIL=admin@surplusfood.local
ADMIN_PASSWORD=ChangeMeStrongAdminPassword123!
ADMIN_FULL_NAME=System Administrator
