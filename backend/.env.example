# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS allowance)
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL with Prisma connection string)
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/surplus_food_db?schema=public

# Authentication (JWT Secret and Expiry)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
